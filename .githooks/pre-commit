#!/usr/bin/env bash
# Enable per clone with:  git config core.hooksPath .githooks
# Scans the staged changes for secrets, then for private deployment details.
set -euo pipefail

root=$(git rev-parse --show-toplevel)

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; install it to scan staged changes" >&2
  exit 1
fi

# Newer gitleaks has `git`; older releases only have `protect`.
if gitleaks git --help >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner
else
  gitleaks protect --staged --redact --no-banner
fi

bash "$root/scripts/check-public.sh"
